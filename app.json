{
  "expo": {
    "name": "Mundi",
    "slug": "mundi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ricardotrindade.mundi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f7f6"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a42f9f88-2794-4950-8c44-7cb38121006f"
      }
    },
    "owner": "escort-inroad"
  }
}
